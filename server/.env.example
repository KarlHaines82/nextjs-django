APP_NAME=CyberBlog

APP_ENV=DEVELOPMENT
API_SECRET_KEY="your-secret-key-here-change-in-production"
API_ALLOWED_HOSTS=".localhost 127.0.0.1 [::1]"

# PostgreSQL Configuration
# Use these credentials or update based on setup_db.sql
POSTGRES_HOST=localhost
POSTGRES_NAME=blogdb
POSTGRES_USER=bloguser
POSTGRES_PASSWORD=yourpassword
POSTGRES_PORT=5432

# Django Superuser (for admin access)
DJANGO_SUPERUSER_PASSWORD=admin123
DJANGO_SUPERUSER_EMAIL=admin@cyberblog.com
DJANGO_SUPERUSER_USERNAME=admin

# Frontend URL (Next.js)
FRONTEND_URL="http://localhost:3000"